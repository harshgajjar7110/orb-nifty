# ==========================================
# ORB Strength Score Engine (OSSE) Environment Config
# Copy this file to .env and populate with your credentials.
# DO NOT COMMIT YOUR REAL .env FILE TO GIT!
# ==========================================

# PostgreSQL Database Credentials (Optional - Engine uses local Parquet storage by default)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=osse_db
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD

# Python Module Search Path
PYTHONPATH=src

